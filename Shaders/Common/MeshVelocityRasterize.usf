#include "/Engine/Private/Common.ush"

// 静态开关(shader 变体)：1 = 按接触体包围盒范围整块写入速度，不读深度
#ifndef MESH_VELOCITY_WRITE_BY_BOUNDS
#define MESH_VELOCITY_WRITE_BY_BOUNDS 0
#endif

struct FMeshVelocityContactBody
{
	float2 WorldMin;
	float2 WorldMax;
	float2 LinearVelocity;
	float2 Pad; // x = 包围盒模式下的接触力度(0~1)
	float2 MoveDir; // 水平运动方向(单位向量)
};

// 输出: xy = 速度(m/s), z = 压入力度, w = 未命中 0 / 命中 1 + Side
// Side = 像素在运动方向垂直轴上的横向位置(0~1)：中线 0.5，运动方向右侧(+Y 侧，当方向为 +X 时) > 0.5，
// 包围盒在该轴上的投影边缘分别为 0 / 1。读取方 saturate(w) 仍得到命中标记
float ComputeLateralSide(float2 WorldXY, FMeshVelocityContactBody Body)
{
	float2 Center = (Body.WorldMin + Body.WorldMax) * 0.5;
	float2 Half = (Body.WorldMax - Body.WorldMin) * 0.5;
	float2 Perp = float2(-Body.MoveDir.y, Body.MoveDir.x);
	float HalfWidth = abs(Half.x * Perp.x) + abs(Half.y * Perp.y);
	return saturate(0.5 + 0.5 * dot(WorldXY - Center, Perp) / max(HalfWidth, 1e-3));
}

Texture2D<float> DepthInput;
RWTexture2D<float4> VelocityOutput;
StructuredBuffer<FMeshVelocityContactBody> ContactBodies;

float4 CaptureLocationAndZ;
int2 OutputSize;
float CaptureRange;
float InteractiveHeight;
float InteractiveDistance;
uint NumContactBodies;


[numthreads(SIZE_X,SIZE_Y,SIZE_Z)]
void MeshVelocityRasterizeCS(uint3 ThreadId : SV_DispatchThreadID)
{
	uint2 PixelId = ThreadId.xy;
	if (any(PixelId >= (uint2)OutputSize))
	{
		return;
	}
	
#if !MESH_VELOCITY_WRITE_BY_BOUNDS
	float Depth = DepthInput.Load(int3(PixelId, 0)).x;
	float FootZ = CaptureLocationAndZ.w + Depth;
	float Penetration = InteractiveHeight - FootZ;
	float Force = saturate(Penetration / InteractiveDistance);
	if (Force <=0.0f)
	{
		VelocityOutput[PixelId] = float4(0,0,0,0);
		return;
	}
#endif
	
	float2 PosUV = (float2(PixelId)+0.5)/float2(OutputSize);
	PosUV.y = 1.0 - PosUV.y;
	float2 WorldXY = CaptureLocationAndZ.xyz + (PosUV - 0.5) * CaptureRange;
	
	float2 BestVelocity = float2(0,0);
	float BestForce = 0;
	float BestSide = 0.5;
	float BestArea = 1e20;
	bool bHit = false;
	
	[loop]
	for (uint i = 0; i < NumContactBodies; ++i)
	{
		FMeshVelocityContactBody Body = ContactBodies[i];
		if (all(WorldXY >= Body.WorldMin) && all(WorldXY <= Body.WorldMax))
		{
			float2 Size = Body.WorldMax - Body.WorldMin;
			float Area = Size.x * Size.y;
			if (Area < BestArea)
			{
				BestArea = Area;
				BestVelocity = Body.LinearVelocity;
				BestForce = Body.Pad.x;
				BestSide = ComputeLateralSide(WorldXY, Body);
				bHit = true;
			}
		}
	}
	
#if MESH_VELOCITY_WRITE_BY_BOUNDS
	float Force = bHit ? BestForce : 0.0;
#endif
	VelocityOutput[PixelId] = float4(BestVelocity, Force, bHit ? 1.0 + BestSide : 0.0);
}
