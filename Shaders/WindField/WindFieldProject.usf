#include "/Engine/Private/Common.ush"
Texture3D<float> WindFieldVelocityXInput;
Texture3D<float> WindFieldVelocityYInput;
Texture3D<float> WindFieldVelocityZInput;
Texture3D<float> WindFieldDivergenceInput;
Texture3D<float> WindFieldPressureInput;

RWTexture3D<float> WindFieldPressureOutput;
RWTexture3D<float> WindFieldDivergenceOutput;

float3 NumCells;
float3 CellSize;

// Pressure projection solves  laplacian(p) = div(v)  and then subtracts grad(p) from v.
// Discretised with per-axis spacing h = CellSize:
//   div(v)      = 0.5 * ( dU/hx + dV/hy + dW/hz )
//   laplacian(p)= sum over axes of (p+ + p- - 2p) / h^2
// so the Jacobi update is
//   p = ( sum(ia * (p+ + p-)) - div ) / ( 2 * sum(ia) ),   ia = 1/h^2
// and the correction is  v -= 0.5 * dp / h.
// Using 1/NumCells.x as a single isotropic h was wrong for non-cubic grids, and the previous
// -h/3 divergence scale combined with a "- Div" in the solver flipped the sign of the whole step.

[numthreads(SIZE_X,SIZE_Y,SIZE_Z)]
void WindFieldProjectFirstCS(uint3 ThreadId : SV_DispatchThreadID)
{
	// Signed indices: subtracting 1 from a uint at index 0 wraps to 0xFFFFFFFF and defeats the clamp.
	int3 pos = int3(ThreadId);
	int3 MaxIdx = int3(NumCells) - 1;

	// GroupCount rounds up, so the last group can contain threads past the texture bounds.
	if (any(pos > MaxIdx))
	{
		return;
	}

	int3 PosRight = int3(min(pos.x + 1, MaxIdx.x), pos.y, pos.z);
	int3 PosLeft  = int3(max(pos.x - 1, 0),        pos.y, pos.z);
	int3 PosFront = int3(pos.x, min(pos.y + 1, MaxIdx.y), pos.z);
	int3 PosBack  = int3(pos.x, max(pos.y - 1, 0),        pos.z);
	int3 PosUp    = int3(pos.x, pos.y, min(pos.z + 1, MaxIdx.z));
	int3 PosDown  = int3(pos.x, pos.y, max(pos.z - 1, 0));

	float U0 = WindFieldVelocityXInput[PosRight];
	float U1 = WindFieldVelocityXInput[PosLeft];
	float V0 = WindFieldVelocityYInput[PosFront];
	float V1 = WindFieldVelocityYInput[PosBack];
	float W0 = WindFieldVelocityZInput[PosUp];
	float W1 = WindFieldVelocityZInput[PosDown];

	// Physical divergence (central difference). Storing it unscaled also makes it directly usable
	// for debug visualisation: after the project pass it should be close to zero everywhere.
	float Divergence = 0.5 * ((U0 - U1) / CellSize.x + (V0 - V1) / CellSize.y + (W0 - W1) / CellSize.z);

	WindFieldDivergenceOutput[pos] = Divergence;
	WindFieldPressureOutput[pos] = 0;
}

[numthreads(SIZE_X,SIZE_Y,SIZE_Z)]
void WindFieldProjectSecondCS(uint3 ThreadId : SV_DispatchThreadID)
{
	int3 pos = int3(ThreadId);
	int3 MaxIdx = int3(NumCells) - 1;

	// GroupCount rounds up, so the last group can contain threads past the texture bounds.
	if (any(pos > MaxIdx))
	{
		return;
	}

	float Divergence = WindFieldDivergenceInput[pos];

	int3 PosRight = int3(min(pos.x + 1, MaxIdx.x), pos.y, pos.z);
	int3 PosLeft  = int3(max(pos.x - 1, 0),        pos.y, pos.z);
	int3 PosFront = int3(pos.x, min(pos.y + 1, MaxIdx.y), pos.z);
	int3 PosBack  = int3(pos.x, max(pos.y - 1, 0),        pos.z);
	int3 PosUp    = int3(pos.x, pos.y, min(pos.z + 1, MaxIdx.z));
	int3 PosDown  = int3(pos.x, pos.y, max(pos.z - 1, 0));

	float PU0 = WindFieldPressureInput[PosRight];
	float PU1 = WindFieldPressureInput[PosLeft];
	float PV0 = WindFieldPressureInput[PosFront];
	float PV1 = WindFieldPressureInput[PosBack];
	float PW0 = WindFieldPressureInput[PosUp];
	float PW1 = WindFieldPressureInput[PosDown];

	float3 InvH2 = 1.0 / (CellSize * CellSize);
	float Denominator = 2.0 * (InvH2.x + InvH2.y + InvH2.z);

	WindFieldPressureOutput[pos] =
		(InvH2.x * (PU0 + PU1) + InvH2.y * (PV0 + PV1) + InvH2.z * (PW0 + PW1) - Divergence) / Denominator;
}
