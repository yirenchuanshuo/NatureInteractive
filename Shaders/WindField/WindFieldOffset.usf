#include "/Engine/Private/Common.ush"
Texture3D<float> WindFieldVelocityXInput;
Texture3D<float> WindFieldVelocityYInput;
Texture3D<float> WindFieldVelocityZInput;

RWTexture3D<float>WindFieldVelocityXOutput;
RWTexture3D<float> WindFieldVelocityYOutput;
RWTexture3D<float> WindFieldVelocityZOutput;

// Whole-cell shift for this frame, already rounded on the CPU (the sub-cell remainder is carried
// across frames there). Kept as float3 because shader parameters are float-typed.
float3 CellOffset;

[numthreads(SIZE_X,SIZE_Y,SIZE_Z)]
void WindFieldOffsetCS(uint3 ThreadId : SV_DispatchThreadID)
{
	int3 pos = int3(ThreadId);

	uint3 Dimensions;
	WindFieldVelocityXOutput.GetDimensions(Dimensions.x, Dimensions.y, Dimensions.z);
	int3 MaxIdx = int3(Dimensions) - 1;

	// GroupCount rounds up, so the last group can contain threads past the texture bounds.
	if (any(pos > MaxIdx))
	{
		return;
	}

	// round() guards against the value arriving as 2.9999 and truncating to 2.
	int3 FinalPos = pos + int3(round(CellOffset));

	// Cells scrolling in from outside the previous field extent have no history, so they must read as
	// "no wind". Clamping to the border instead (the old behaviour) smeared the edge row across the
	// newly exposed region and produced streaks trailing along the movement direction.
	bool bInside = all(FinalPos >= 0) && all(FinalPos <= MaxIdx);

	WindFieldVelocityXOutput[pos] = bInside ? WindFieldVelocityXInput[FinalPos] : 0.0f;
	WindFieldVelocityYOutput[pos] = bInside ? WindFieldVelocityYInput[FinalPos] : 0.0f;
	WindFieldVelocityZOutput[pos] = bInside ? WindFieldVelocityZInput[FinalPos] : 0.0f;
}
