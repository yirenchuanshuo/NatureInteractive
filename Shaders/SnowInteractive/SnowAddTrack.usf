#include "/Engine/Private/Common.ush"
Texture2D<float> SnowForceInput;
Texture2D SnowTrackInput;
RWTexture2D<float4> SnowOutput;
float InteractiveHeight;
float InteractiveDistance;
float CaptureZ;
float FadeSpeed;
float FallingSpeed;
float DeltaTime;

[numthreads(SIZE_X,SIZE_Y,SIZE_Z)]
void SnowAddTrackCS(uint3 ThreadId : SV_DispatchThreadID)
{

	float Depth = SnowForceInput[ThreadId.xy].x;
	float FootZ = CaptureZ + Depth;

	float Penetration = InteractiveHeight - FootZ;

	float Force = saturate(Penetration / InteractiveDistance);


	float SnowTrackTemp = SnowTrackInput[ThreadId.xy].x;
	SnowTrackTemp = max(SnowTrackTemp.r , Force);
	float SnowFallingNew = SnowTrackTemp - SnowTrackInput[ThreadId.xy].x;
	float SnowFallingOld = SnowTrackInput[ThreadId.xy].y - DeltaTime * FallingSpeed;
	float SnowFallRange = max(SnowFallingNew, SnowFallingOld);

	float SnowTrack = SnowTrackInput[ThreadId.xy].x - DeltaTime * FadeSpeed;
	SnowTrack = max(SnowTrack.r , Force);


	SnowOutput[ThreadId.xy] = float4(SnowTrack,SnowFallRange,0,1);
}

Texture2D SnowVelocityInput;
Texture2D SnowVelocityTrackInput;
RWTexture2D<float4> SnowVelocityTrackOutput;
float VelocityFadeSpeed;

[numthreads(SIZE_X,SIZE_Y,SIZE_Z)]
void SnowAddVelocityTrackCS(uint3 ThreadId : SV_DispatchThreadID)
{
	uint2 Pos = ThreadId.xy;
	uint Width, Height;
	SnowVelocityTrackOutput.GetDimensions(Width, Height);
	if (Pos.x >= Width || Pos.y >= Height)
	{
		return;
	}

	float4 In = SnowVelocityInput[Pos];
	float2 NewV = In.xy;
	float2 OldV = SnowVelocityTrackInput[Pos].xy;
	// z: 压入力度, w: 是否命中接触体；未命中时不注入，避免把有深度但无速度信息的区域强制清零
	float Force = saturate(In.z) * saturate(In.w);

	float Damp = saturate(1.0-DeltaTime * VelocityFadeSpeed);
	OldV *= Damp;

	float2 V = lerp(OldV, NewV, Force);

	SnowVelocityTrackOutput[Pos] = float4(V,0,1);
}

// SnowVelocityInput: xy = 速度, z = 压入力度, w = 是否命中接触体
// 输出: xy = 轨迹速度, z = 轨迹强度, w = 写入计时(写入时为 1，按 Lifetime 线性衰减到 0)
//
// 膨胀采用可分离的两遍(横向 -> 纵向)：权重为高斯 g(d) = exp(-DilateFalloff * d²)，
// g(dx)·g(dy) = g(r) 各向同性，因此加权和与加权最大值都可以精确拆成两个一维过程，
// 每像素采样数从 O(R²) 降到 O(2R)
Texture2D VelocityTrackHistory;
RWTexture2D<float4> VelocityTrackResult;
float VelocityTrackFadeSpeed;
int DilateRadius;
float DilateFalloff;      // 高斯系数，C++ 端由 FalloffPow 与半径换算
float TimerInvLifetime;   // 1 / Lifetime(s)
float TimerContactThreshold;
float TimerMinSpeed;      // 与 SnowVelocityInput 同单位(m/s)，0 为不限制

float DilateWeight(int D)
{
	return exp(-DilateFalloff * float(D * D));
}

//------------------------------------------------------------------------------
// 横向：A = (Σ速度·权重, Σ权重, max 权重)，B = 满足计时条件的 max 权重
//------------------------------------------------------------------------------
RWTexture2D<float4> DilateHOutputA;
RWTexture2D<float> DilateHOutputB;

[numthreads(SIZE_X,SIZE_Y,SIZE_Z)]
void SnowDilateVelocityTrackHCS(uint3 ThreadId : SV_DispatchThreadID)
{
	int2 Pos = int2(ThreadId.xy);
	uint Width, Height;
	DilateHOutputA.GetDimensions(Width, Height);
	if (Pos.x >= (int)Width || Pos.y >= (int)Height)
	{
		return;
	}

	float2 SumV = 0;
	float SumW = 0;
	float MaxW = 0;
	float MaxTimerW = 0;

	[loop]
	for (int x = -DilateRadius; x <= DilateRadius; ++x)
	{
		int SampleX = Pos.x + x;
		if (SampleX < 0 || SampleX >= (int)Width)
		{
			continue;
		}

		float4 In = SnowVelocityInput[int2(SampleX, Pos.y)];
		float Contact = saturate(In.z) * saturate(In.w);
		if (Contact <= 0.0)
		{
			continue;
		}

		float W = Contact * DilateWeight(x);
		SumV += In.xy * W;
		SumW += W;
		MaxW = max(MaxW, W);
		if (length(In.xy) >= TimerMinSpeed)
		{
			MaxTimerW = max(MaxTimerW, W);
		}
	}

	DilateHOutputA[Pos] = float4(SumV, SumW, MaxW);
	DilateHOutputB[Pos] = MaxTimerW;
}

//------------------------------------------------------------------------------
// 纵向 + 累积
//------------------------------------------------------------------------------
Texture2D<float4> DilateHInputA;
Texture2D<float> DilateHInputB;

[numthreads(SIZE_X,SIZE_Y,SIZE_Z)]
void SnowAccumulateVelocityTrackCS(uint3 ThreadId : SV_DispatchThreadID)
{
	int2 Pos = int2(ThreadId.xy);
	uint Width, Height;
	VelocityTrackResult.GetDimensions(Width, Height);
	if (Pos.x >= (int)Width || Pos.y >= (int)Height)
	{
		return;
	}

	float2 SumV = 0;
	float SumW = 0;
	float MaxW = 0;
	float MaxTimerW = 0;

	[loop]
	for (int y = -DilateRadius; y <= DilateRadius; ++y)
	{
		int SampleY = Pos.y + y;
		if (SampleY < 0 || SampleY >= (int)Height)
		{
			continue;
		}

		float4 H = DilateHInputA[int2(Pos.x, SampleY)];
		if (H.w <= 0.0)
		{
			continue;
		}

		float G = DilateWeight(y);
		SumV += H.xy * G;
		SumW += H.z * G;
		MaxW = max(MaxW, H.w * G);
		MaxTimerW = max(MaxTimerW, DilateHInputB[int2(Pos.x, SampleY)] * G);
	}

	float2 NewV = SumW > 1e-5 ? SumV / SumW : float2(0, 0);

	float4 History = VelocityTrackHistory[Pos];
	float Damp = saturate(1.0 - DeltaTime * VelocityTrackFadeSpeed);
	float2 OldV = History.xy * Damp;
	float OldStrength = History.z * Damp;

	float2 V = lerp(OldV, NewV, MaxW);
	float Strength = max(OldStrength, MaxW);

	// 计时写入：加宽范围内有足够强的接触(且速度达标)就置 1；之后线性衰减，Lifetime 秒后严格为 0
	float TimerWrite = MaxTimerW > TimerContactThreshold ? 1.0 : 0.0;
	float Timer = max(max(History.w - DeltaTime * TimerInvLifetime, 0.0), TimerWrite);

	VelocityTrackResult[Pos] = float4(V, Strength, Timer);
}