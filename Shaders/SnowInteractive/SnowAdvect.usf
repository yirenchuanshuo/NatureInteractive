#include "/Engine/Private/Common.ush"

// 半拉格朗日平流
// 速度纹理存的是世界空间 m/s，VelocityToTexel 负责换算到 texel/s 并翻转 Y
Texture2D<float4> SnowDiffusionInput;
RWTexture2D<float4> SnowAdvectOutput;
int2 TextureSize;
float2 VelocityToTexel;
float DeltaTime;
float Viscosity;

static const float MaxStepTexel = 4.0;

[numthreads(SIZE_X,SIZE_Y,SIZE_Z)]
void SnowAdvectCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	int2 Pos = int2(DispatchThreadId.xy);
	if (any(Pos >= TextureSize))
	{
		return;
	}

	float2 V0 = SnowDiffusionInput.Load(int3(Pos, 0)).xy;

	float2 Step = V0 * VelocityToTexel * DeltaTime;
	float StepLen = length(Step);
	if (StepLen > MaxStepTexel)
	{
		Step *= MaxStepTexel / StepLen;
	}

	const float2 Size = (float2)TextureSize;
	float2 Back = (float2)Pos + 0.5 - Step;
	Back = clamp(Back, 0.5, Size - 0.5);

	float2 BackTexel = Back - 0.5;
	int2 I0 = (int2)floor(BackTexel);
	float2 F = BackTexel - (float2)I0;
	int2 I1 = min(I0 + 1, TextureSize - 1);
	I0 = clamp(I0, 0, TextureSize - 1);

	float2 V00 = SnowDiffusionInput.Load(int3(I0.x, I0.y, 0)).xy;
	float2 V10 = SnowDiffusionInput.Load(int3(I1.x, I0.y, 0)).xy;
	float2 V01 = SnowDiffusionInput.Load(int3(I0.x, I1.y, 0)).xy;
	float2 V11 = SnowDiffusionInput.Load(int3(I1.x, I1.y, 0)).xy;

	float2 V = lerp(lerp(V00, V10, F.x), lerp(V01, V11, F.x), F.y);
	V *= exp(-Viscosity * DeltaTime);

	SnowAdvectOutput[Pos] = float4(V, 0, 1);
}
