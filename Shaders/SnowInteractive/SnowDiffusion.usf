#include "/Engine/Private/Common.ush"

// 隐式扩散 (I - a·∇²) x = b 的 Jacobi 迭代
// b: 本帧扩散前的速度（迭代过程中保持不变）
// x: 上一次迭代结果
Texture2D<float4> SnowVelocitySource;
Texture2D<float4> SnowVelocityPrev;
RWTexture2D<float4> SnowDiffusionOutput;
int2 TextureSize;
float Alpha; // DeltaTime * Diffusion，单位 texel²

[numthreads(SIZE_X,SIZE_Y,SIZE_Z)]
void SnowDiffusionCS(uint3 ThreadId : SV_DispatchThreadID)
{
	int2 Pos = int2(ThreadId.xy);
	if (any(Pos >= TextureSize))
	{
		return;
	}

	const int2 MaxPos = TextureSize - 1;
	float2 B = SnowVelocitySource[Pos].xy;
	float2 VRight = SnowVelocityPrev[min(Pos + int2(1, 0), MaxPos)].xy;
	float2 VLeft  = SnowVelocityPrev[max(Pos - int2(1, 0), 0)].xy;
	float2 VDown  = SnowVelocityPrev[min(Pos + int2(0, 1), MaxPos)].xy;
	float2 VUp    = SnowVelocityPrev[max(Pos - int2(0, 1), 0)].xy;

	float2 V = (B + Alpha * (VRight + VLeft + VDown + VUp)) / (1.0 + 4.0 * Alpha);
	SnowDiffusionOutput[Pos] = float4(V, 0, 1);
}
